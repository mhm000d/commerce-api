# PostgreSQL
POSTGRES_USER=commerce_user
POSTGRES_PASSWORD=commerce_password
POSTGRES_DB=commerceDb

# JWT
JWT_KEY=CommerceDevelopmentSigningKey-ChangeMe-ForLocalOnly-1234567890
JWT_ISSUER=CommerceApi
JWT_AUDIENCE=CommerceClient
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7

# Frontend / CORS
FRONTEND_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGIN_0=http://localhost:3000
CORS_ALLOWED_ORIGIN_1=https://localhost:3000

# Rate limiting
RATE_LIMITING_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_ANONYMOUS_PERMIT_LIMIT=120
RATE_LIMIT_AUTHENTICATED_PERMIT_LIMIT=600
RATE_LIMIT_AUTH_ENDPOINT_PERMIT_LIMIT=30

# Stripe test integration
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Local email
SMTP_USERNAME=test
SMTP_PASSWORD=test
EMAIL_FROM_ADDRESS=noreply@commerce.local
EMAIL_FROM_NAME=Commerce Store

# AWS / S3 image storage
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
S3_BUCKET_NAME=commerce-product-images-local
